lazy-lock.json

# tests/ is private, EXCEPT the language capability harness. That is maintainer
# infrastructure rather than the user-facing suite the rest of tests/ holds: it
# grades every language bundle against the eight checkpoints in
# dev-docs/language-bundle-contract.md, and the nightly workflow has to be able
# to check it out and run it.
#
# The exclusion is on tests/* rather than tests/, because git does not descend
# into an excluded directory and a negation inside one never applies.
tests/*
!tests/capability.sh
!tests/capability_assert.lua
!tests/capability_provision.lua
!tests/fixtures/
tests/fixtures/*
!tests/fixtures/lang/

# Fixture build output: regenerated by the harness on every run, and large.
tests/fixtures/lang/*/target/
tests/fixtures/lang/*/build/
tests/fixtures/lang/*/node_modules/
tests/fixtures/lang/*/__pycache__/
tests/fixtures/lang/*/.pytest_cache/
tests/fixtures/lang/*/package-lock.json
tests/fixtures/lang/c/main
tests/fixtures/lang/c/main_debug
tests/fixtures/lang/go/capfixture
tests/fixtures/lang/rust/Cargo.lock
tests/fixtures/lang/c/doctest.h
tests/fixtures/lang/*/*.dSYM/
# jdtls writes an Eclipse project into whatever it opens.
tests/fixtures/lang/java/.classpath
tests/fixtures/lang/java/.project
tests/fixtures/lang/java/.settings/
.DS_Store
.cache
.claude/
dev-docs/
# Ship at the beta cut, not in alpha: drop these lines then. CONTRIBUTING.md
# carries the Documentation Style section that doc/noethervim.txt is written
# against; CLAUDE.md is the arbiter that routes to it.
CONTRIBUTING.md
CLAUDE.md
.keys
README_backup.md
