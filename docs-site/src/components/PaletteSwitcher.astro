---
// TEMPORARY. A live accent-palette picker, sitting next to the GitHub icon so
// candidate schemes can be compared on the real site before one is committed.
//
// To remove: delete this file, drop the `components.SocialIcons` override in
// astro.config.mjs, and paste the winning palette's three values into
// src/styles/custom.css.
import Default from '@astrojs/starlight/components/SocialIcons.astro';

// Each entry is [low, base, high]: the three accent slots Starlight themes
// from. Names match the Neovim colourschemes they are drawn from, so a pick
// here can be matched by the distro's shipped default later.
const PALETTES = [
  ['violet', 'Violet (current)'],
  ['catppuccin', 'Catppuccin Mauve'],
  ['tokyonight', 'Tokyo Night'],
  ['kanagawa', 'Kanagawa Wave'],
  ['rosepine', 'Rose Pine'],
  ['everforest', 'Everforest'],
  ['gruvbox', 'Gruvbox'],
  ['nord', 'Nord'],
];
---

<Default><slot /></Default>

<label class="palette-switcher">
  <span class="sr-only">Accent palette</span>
  <select id="palette-select" aria-label="Accent palette">
    {PALETTES.map(([value, label]) => <option value={value}>{label}</option>)}
  </select>
</label>

<script>
  const KEY = 'nv-docs-palette';
  const select = document.getElementById('palette-select') as HTMLSelectElement | null;
  if (select) {
    const saved = localStorage.getItem(KEY) || 'violet';
    document.documentElement.dataset.palette = saved;
    select.value = saved;
    select.addEventListener('change', () => {
      document.documentElement.dataset.palette = select.value;
      localStorage.setItem(KEY, select.value);
    });
  }
</script>

<style>
  .palette-switcher {
    display: flex;
    align-items: center;
  }

  .palette-switcher select {
    background-color: var(--sl-color-black);
    color: var(--sl-color-gray-1);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    padding: 0.25rem 0.4rem;
    font-size: var(--sl-text-xs);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
